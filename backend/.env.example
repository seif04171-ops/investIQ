APP_NAME=InvestIQ
ENV=development
DEBUG=true

DATABASE_URL=postgresql://investiq:investiq@localhost:5432/investiq

# Auth — self-hosted, no external account needed.
# CHANGE THIS before deploying anywhere real; fine as-is for local dev.
JWT_SECRET_KEY=dev-secret-change-this-before-any-real-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=10080

ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

NEWSAPI_KEY=
MARKETAUX_KEY=

NEWS_POLL_INTERVAL_MINUTES=20
